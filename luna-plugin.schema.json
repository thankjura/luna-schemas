{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Luna plugin",
  "description": "Luna plugin descriptor schema",
  "type": "object",

  "$defs": {
    "Resource": {
      "type": "object",
      "properties": {
        "key":       { "type": "string", "description": "Resources key: baseName for i18n, componentName for component" },
        "type":      { "type": "string", "description": "Resource type", "enum": ["i18n", "comp", "css", "any"] },
        "path":      { "type": "string", "description": "Relative path from resource folder", "format": "path" }
      },
      "required": ["key", "type", "path"],
      "additionalProperties": false
    },
    "BaseComponent": {
      "type": "object",
      "properties": {
        "key": {
          "description": "Component key",
          "type": "string"
        },
        "name": {
          "description": "Component name",
          "type": "string"
        },
        "className": {
          "description": "Component class",
          "type": "string",
          "x-intellij-class-name": true
        },
        "resources": {
          "$ref": "#/$defs/ResourcesList"
        }
      },
      "required": ["key", "className", "name"]
    },
    "WebComponent": {
      "type": "object",
      "properties": {
        "name":      { "type": "string", "description": "componentName for component" },
        "path":      { "type": "string", "description": "Relative path to component from resource folder", "format": "path" }
      },
      "anyOf": [
        { "required": ["path"] },
        { "required": ["name"] }
      ],
      "additionalProperties": false
    },
    "WorkflowFunction": {
      "allOf": [
        { "$ref": "#/$defs/BaseComponent"},
        {
          "type": "object",
          "properties": {
            "viewComponent": {
              "description": "View component",
              "$ref": "#/$defs/WebComponent"
            },
            "editComponent": {
              "description": "Edit component",
              "$ref": "#/$defs/WebComponent"
            }
          }
        }
      ]
    },
    "ResourcesList": {
      "type": "array",
      "items": { "$ref": "#/$defs/Resource" },
      "minItems": 0
    },

    "WebRoute": {
      "type": "object",
      "properties": {
        "routeName":       { "type": "string", "description": "Unique route name" },
        "routePath":       { "type": "string", "description": "Route path" },
        "component":       { "type": "string", "description": "Component path", "format": "path" },
        "children":        { "type": "array",  "description":  "Children routes", "items": { "$ref": "#/$defs/WebRoute" }},
        "parent":          { "type": "string", "description": "Parent route(ex. admin)" }
      }
    }
  },
  "properties": {
    "key": {
      "description": "The unique key of plugin",
      "type": "string"
    },
    "name": {
      "description": "The name of plugin",
      "type": "string"
    },
    "description": {
      "description": "The description of plugin",
      "type": "string"
    },
    "version": {
      "description": "The version of plugin",
      "type": "string"
    },
    "vendor": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Vendor name",
          "type": "string"
        },
        "url": {
          "description": "Vendor url",
          "type": "string"
        }
      },
      "required": ["name", "url"]
    },
    "scanPackages": {
      "description": "Collection of package names for scan",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "restPackages": {
      "description": "Rest packages",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Name of rest group",
            "type": "string"
          },
          "packages": {
            "description": "A packages containing REST controllers",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": ["packages"]
        }
      }
    },
    "resources": {
      "$ref": "#/$defs/ResourcesList"
    },
    "routes":  {
      "type": "array",
      "description": "Web routes",
      "items": { "$ref": "#/$defs/WebRoute" }
    },
    "activeDocs": {
      "type": "array",
      "description": "List of ActiveDocs classes",
      "items": {
        "type": "string",
        "x-intellij-class-name": true
      }
    },
    "fieldTypes": {
      "type": "array",
      "description": "Define customfield types",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/BaseComponent" },
          {
            "type": "object",
            "properties": {
              "viewComponents": {
                "description": "View components",
                "type": "array",
                "items": { "$ref": "#/$defs/WebComponent" }
              },
              "editComponents": {
                "description": "Edit components",
                "type": "array",
                "items": { "$ref": "#/$defs/WebComponent" }
              },
              "navigatorComponents": {
                "description": "Navigator components path",
                "type": "array",
                "items": { "$ref": "#/$defs/WebComponent" }
              },
              "optionsComponent": {
                "description": "Options component",
                "$ref": "#/$defs/WebComponent"
              },
              "iconPath": {
                "description": "Icon path",
                "type": "string",
                "format": "path"
              }
            }
          }
        ]
      }
    },
    "fieldSearchers": {
      "type": "array",
      "description": "Define customfield searchers",
      "items": {
        "$ref": "#/$defs/BaseComponent"
      }
    },
    "webSections": {
      "type": "array",
      "description": "Define custom web sections",
      "items": {
        "$ref": "#/$defs/BaseComponent"
      }
    },
    "webSectionProviders": {
      "type": "array",
      "description": "Define web section providers",
      "items": {
        "$ref": "#/$defs/BaseComponent"
      }
    },
    "webItems": {
      "type": "array",
      "description": "Define custom web items",
      "items": {
        "$ref": "#/$defs/BaseComponent"
      }
    },
    "webItemProviders": {
      "type": "array",
      "description": "Define custom web item providers",
      "items": {
        "$ref": "#/$defs/BaseComponent"
      }
    },
    "issuesExportModules": {
      "type": "array",
      "description": "Define issues export modules",
      "items": {
        "$ref": "#/$defs/BaseComponent"
      }
    },
    "queryFunctions": {
      "type": "array",
      "description": "Define issues export modules",
      "items": {
        "$ref": "#/$defs/BaseComponent"
      }
    },
    "workflowConditions": {
      "type": "array",
      "description": "Define workflow conditions",
      "items": {
        "$ref": "#/$defs/WorkflowFunction"
      }
    },
    "workflowValidators": {
      "type": "array",
      "description": "Define workflow validators",
      "items": {
        "$ref": "#/$defs/WorkflowFunction"
      }
    },
    "workflowPostfunctions": {
      "type": "array",
      "description": "Define workflow postfunctions",
      "items": {
        "$ref": "#/$defs/WorkflowFunction"
      }
    },
    "components": {
      "description": "Collection of defined components",
      "type": "array",
      "items": {
        "$ref": "#/$defs/BaseComponent"
      }
    }
  },
  "required": ["key", "name", "version", "vendor"]
}
